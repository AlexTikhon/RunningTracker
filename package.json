{
  "name": "running-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.11.0 <25",
    "npm": ">=11.6.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "concurrently --kill-others-on-fail --names api,web \"npm run dev --workspace=@running-tracker/api\" \"npm run dev --workspace=@running-tracker/web\"",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:migrations && npm run test --workspaces --if-present",
    "test:migrations": "node --test scripts/*.test.mjs",
    "test:integration": "npm run test:integration --workspace=@running-tracker/api",
    "backup:create": "npm run backup --workspace=@running-tracker/api -- create",
    "backup:verify": "npm run backup --workspace=@running-tracker/api -- verify",
    "backup:decrypt": "npm run backup --workspace=@running-tracker/api -- decrypt",
    "backup:prune": "npm run backup --workspace=@running-tracker/api -- prune",
    "backup:keygen": "npm run backup --workspace=@running-tracker/api -- keygen",
    "restore:drill": "npm run restore:drill --workspace=@running-tracker/api --",
    "restore:reapply-deletions": "npm run restore:reapply-deletions --workspace=@running-tracker/api --",
    "load:explain": "npm run load:explain --workspace=@running-tracker/api --",
    "load:report": "npm run load:report --workspace=@running-tracker/api --",
    "load:run": "npm run load:run --workspace=@running-tracker/api --",
    "load:seed": "npm run load:seed --workspace=@running-tracker/api --",
    "simulate:gps": "npm run simulate --workspace=@running-tracker/gps-simulator --",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "db:up": "docker compose -f infra/compose/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/compose/docker-compose.yml down",
    "db:logs": "docker compose -f infra/compose/docker-compose.yml logs -f postgres",
    "db:bootstrap": "node scripts/bootstrap-database.mjs",
    "db:bootstrap:test": "node scripts/bootstrap-database.mjs --test",
    "db:migrate": "node scripts/migrate.mjs",
    "db:migrate:test": "node scripts/migrate.mjs --test",
    "transport:tls": "node scripts/generate-local-tls.mjs",
    "transport:up": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.transport.yml up -d --build --wait",
    "transport:down": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.transport.yml rm --stop --force proxy api",
    "transport:verify": "node scripts/verify-transport-profile.mjs",
    "deploy:secrets": "node scripts/generate-production-secrets.mjs",
    "deploy:verify": "node scripts/verify-production-profile.mjs"
  },
  "dependencies": {
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "concurrently": "9.2.4",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0"
  }
}
