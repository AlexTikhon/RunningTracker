# Inputs for infra/compose/docker-compose.production.yml. No credential belongs in this file:
# secrets are files (npm run deploy:secrets -- --dir <SECRETS_DIR>). Copy to a private path and pass
#   docker compose -f infra/compose/docker-compose.production.yml --env-file <that file> up -d --build --wait

# Public name and origin exactly as browsers see them. PUBLIC_ORIGIN is the only allowed Origin for
# state-changing requests, the CSRF/Origin boundary, and the target of the HTTP->HTTPS redirect.
PUBLIC_HOSTNAME=tracker.example
PUBLIC_ORIGIN=https://tracker.example

# Absolute paths on the host.
SECRETS_DIR=/etc/running-tracker/secrets
# Holds fullchain.pem and privkey.pem issued for PUBLIC_HOSTNAME.
TLS_DIR=/etc/running-tracker/tls
# Must be a mount that survives loss of this host (another disk, volume, or machine); writable by uid 1000.
DELETION_JOURNAL_HOST_DIR=/mnt/running-tracker-journal

# Optional. Defaults shown; the memory and CPU limits are starting values, not measured capacity.
# BIND_ADDRESS=0.0.0.0
# HTTP_PORT=80
# HTTPS_PORT=443
# IMAGE_TAG=production
# COMPOSE_PROJECT_NAME=running-tracker
# POSTGRES_MEM_LIMIT=2g
# POSTGRES_CPUS=4
# API_MEM_LIMIT=512m
# API_CPUS=2
# PROXY_MEM_LIMIT=128m
# PROXY_CPUS=1
