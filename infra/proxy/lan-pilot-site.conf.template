# iPhone LAN pilot site (docs/runbooks/iphone-lan-pilot.md). Substituted at container start: PILOT_HOST, the private
# address or name the phone opens (server_name, no port). The container entrypoint substitutes only variables that
# exist in its environment, and compose marks it required. Same API, SSE and header policy as the deployment site.

upstream running_tracker_api {
  server api:3000;
  keepalive 16;
}

# Container-internal liveness for the health check only. Port 80 is never published.
server {
  listen 80 default_server;
  server_name _;

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok";
  }

  location / {
    return 404;
  }
}

# Safari sends no TLS server name when a site is opened by address (RFC 6066 forbids an IP literal in SNI), so unlike
# the deployment site the handshake cannot be refused by name: every client is offered the pilot certificate. A request
# whose Host is not the pilot host lands here and is answered 421 Misdirected Request, before the app or the API.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name _;

  ssl_certificate /etc/nginx/tls/server-cert.pem;
  ssl_certificate_key /etc/nginx/tls/server-key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_timeout 10m;
  ssl_session_cache shared:TLS:1m;
  ssl_session_tickets off;

  include /etc/nginx/snippets/security-headers.conf;

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    return 421;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${PILOT_HOST};

  ssl_certificate /etc/nginx/tls/server-cert.pem;
  ssl_certificate_key /etc/nginx/tls/server-key.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 10m;
  ssl_session_cache shared:TLS:1m;
  ssl_session_tickets off;

  root /usr/share/nginx/html;
  index index.html;
  client_max_body_size 128k;

  include /etc/nginx/snippets/security-headers.conf;

  # Live SSE: the verified no-buffer / no-cache / no-compression / no-retry policy (ADR-0026).
  location ~ ^/api/orgs/[^/]+/live/?$ {
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass http://running_tracker_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Accept-Encoding "";

    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 75s;
    send_timeout 30s;

    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_next_upstream off;
    gzip off;
    proxy_pass_header X-Accel-Buffering;
  }

  location /api/ {
    include /etc/nginx/snippets/security-headers.conf;
    proxy_pass http://running_tracker_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_next_upstream off;
    proxy_cache off;
  }

  # Vite emits content-hashed file names under /assets/.
  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-cache" always;
    try_files $uri $uri/ /index.html;
  }
}
