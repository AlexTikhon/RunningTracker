# Local development only. These fixed credentials are not valid for deployment.
APP_ENV=development
PORT=3000
# Fixed development/test fixtures. Use independent secrets in any deployed environment.
BOOTSTRAP_DATABASE_URL=postgresql://running_tracker:running_tracker_local@127.0.0.1:5433/running_tracker
TEST_BOOTSTRAP_DATABASE_URL=postgresql://running_tracker:running_tracker_local@127.0.0.1:5433/running_tracker_test
MIGRATION_DATABASE_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker
TEST_MIGRATION_DATABASE_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker_test
DATABASE_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker
TEST_DATABASE_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker_test
MAINTENANCE_DATABASE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker
TEST_MAINTENANCE_DATABASE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker_test
# Implementation cadence only; the product guarantee remains the first cycle after 24 hours.
RUN_AUTO_FINISH_INTERVAL_MS=60000
# Each cycle claims and deletes at most one bounded raw-point batch.
RUN_RAW_PURGE_INTERVAL_MS=60000
# Each cycle claims and whole-run-deletes at most one run finished over a year ago.
RUN_RETENTION_DELETE_INTERVAL_MS=60000
# Each cycle runs a bounded worker batch; database claims deduplicate across processes.
RUN_SUMMARY_INTERVAL_MS=60000
RUN_SUMMARY_CONCURRENCY=2
LIVE_SSE_POLL_INTERVAL_MS=2000
LIVE_SSE_HEARTBEAT_INTERVAL_MS=15000
LIVE_SSE_BACKPRESSURE_TIMEOUT_MS=10000
LIVE_SSE_MAX_CONNECTIONS=64
LIVE_SSE_POLL_CONCURRENCY=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=1000
SHUTDOWN_TIMEOUT_MS=5000
# Fixed local-only 35-byte HMAC key (unpadded base64url). Replace in every deployment.
LIVE_TRACK_CURSOR_SIGNING_KEY=cnVubmluZy10cmFja2VyLWxvY2FsLWN1cnNvci1rZXktdjE
# Local session fixture. It is disabled by default and rejected in production.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_USER_IDS=11111111-1111-4111-8111-111111111111
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Public browser token for the optional Mapbox archive view. Leave empty for tokenless tests.
VITE_MAPBOX_ACCESS_TOKEN=
# Explicit HTTP exception for local development/test only. Production requires true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_MS=28800000
SESSION_STORE_MAX_ENTRIES=100
