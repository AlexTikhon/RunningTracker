# Local development only. These fixed credentials are not valid for deployment.
APP_ENV=development
PORT=3000
# Fixed development/test fixtures. Use independent secrets in any deployed environment.
BOOTSTRAP_DATABASE_URL=postgresql://running_tracker:running_tracker_local@127.0.0.1:5433/running_tracker
TEST_BOOTSTRAP_DATABASE_URL=postgresql://running_tracker:running_tracker_local@127.0.0.1:5433/running_tracker_test
MIGRATION_DATABASE_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker
TEST_MIGRATION_DATABASE_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker_test
DATABASE_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker
TEST_DATABASE_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker_test
MAINTENANCE_DATABASE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker
TEST_MAINTENANCE_DATABASE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker_test
# Implementation cadence only; the product guarantee remains the first cycle after 24 hours.
RUN_AUTO_FINISH_INTERVAL_MS=60000
# Each cycle claims and deletes at most one bounded raw-point batch.
RUN_RAW_PURGE_INTERVAL_MS=60000
# Each cycle claims and whole-run-deletes at most one run finished over a year ago.
RUN_RETENTION_DELETE_INTERVAL_MS=60000
# Each cycle reclaims at most 500 tombstones that are at least a year past deletion; a delay only extends protection.
RUN_TOMBSTONE_RECLAIM_INTERVAL_MS=300000
# Absolute directory on storage OUTSIDE the database host that receives exported deletion journal files. Required in production; unset keeps deletions only in the database outbox.
# DELETION_JOURNAL_DIR=/var/lib/running-tracker/deletion-journal
# Each cycle exports at most 500 journal rows; this interval bounds the journal's recovery point when healthy.
RUN_DELETION_JOURNAL_EXPORT_INTERVAL_MS=30000
# Each cycle runs a bounded worker batch; database claims deduplicate across processes.
RUN_SUMMARY_INTERVAL_MS=60000
RUN_SUMMARY_CONCURRENCY=2
LIVE_SSE_POLL_INTERVAL_MS=2000
LIVE_SSE_HEARTBEAT_INTERVAL_MS=15000
LIVE_SSE_BACKPRESSURE_TIMEOUT_MS=10000
LIVE_SSE_MAX_CONNECTIONS=64
LIVE_SSE_POLL_CONCURRENCY=2
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=2000
DB_QUERY_TIMEOUT_MS=1000
# Runtime SQL budgets, milliseconds, applied by PostgreSQL itself to every runtime-pool connection (maintenance excluded).
# DB_STATEMENT_TIMEOUT_MS cancels any one statement (it includes time spent waiting for a lock); DB_LOCK_TIMEOUT_MS cancels a wait for a lock and must not exceed it.
# A cancelled request is rolled back and answered 503 DB_STATEMENT_TIMEOUT or DB_LOCK_TIMEOUT. Both are 1..60000.
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
SHUTDOWN_TIMEOUT_MS=5000
# In a deployment, DATABASE_URL, MAINTENANCE_DATABASE_URL and LIVE_TRACK_CURSOR_SIGNING_KEY are read from files named by <NAME>_FILE (absolute path); setting both forms is an error.
# Fixed local-only 35-byte HMAC key (unpadded base64url). Replace in every deployment.
LIVE_TRACK_CURSOR_SIGNING_KEY=cnVubmluZy10cmFja2VyLWxvY2FsLWN1cnNvci1rZXktdjE
# Local session fixture. It is disabled by default and rejected in production.
LOCAL_AUTH_ENABLED=false
LOCAL_AUTH_USER_IDS=11111111-1111-4111-8111-111111111111
ALLOWED_ORIGINS=http://127.0.0.1:5173
# Public browser token for the optional Mapbox archive view. Leave empty for tokenless tests.
VITE_MAPBOX_ACCESS_TOKEN=
# Explicit HTTP exception for local development/test only. Production requires true.
SESSION_COOKIE_SECURE=false
SESSION_TTL_MS=28800000
SESSION_STORE_MAX_ENTRIES=100
# Production sign-in (P12.1): OpenID Connect. All four of the first block are required together, and in production.
# In a deployment OIDC_CLIENT_SECRET is read from the file named by OIDC_CLIENT_SECRET_FILE (absolute path).
# Plain http is accepted only for a loopback issuer outside production. See docs/runbooks/identity-provider.md.
# OIDC_ISSUER_URL=https://idp.example/realms/running-tracker
# OIDC_CLIENT_ID=running-tracker
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://tracker.example/api/auth/callback
# OIDC_SCOPES=openid
# OIDC_LOGIN_TTL_MS=600000
# OIDC_POST_LOGIN_PATH=/
# OIDC_STORE_MAX_ENTRIES=100
# Optional Prometheus-format scrape listener (P11.1). Unset disables it. It has no authentication:
# keep METRICS_HOST on loopback or a trusted network. METRICS_PORT must differ from PORT.
# METRICS_PORT=9464
# METRICS_HOST=127.0.0.1
# Load-dataset seeder (P11.2). Object-owner URL of a DEDICATED database whose name ends in _load_test; never a runtime or production database.
# LOAD_DATABASE_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker_load_test
# Load runner (P11.3) additionally needs the two roles the API itself uses, on the same loopback _load_test database.
# LOAD_RUNTIME_DATABASE_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker_load_test
# LOAD_MAINTENANCE_DATABASE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker_load_test
# Set to true to leave raw-purge/annual-retention/tombstone jobs at their normal cadence during a load run (they rewrite the aging dataset).
# LOAD_KEEP_RETENTION_JOBS=false

# Backup and restore drill (P12.3).
# Daily backup: the connection must be an administrator (superuser) login so that every row is read regardless of row-level security. Not used by the application.
# BACKUP_DATABASE_URL=postgresql://running_tracker_admin:<secret>@db.internal:5432/running_tracker
# Absolute path of a file holding the 32-byte backup key as 64 hex characters (create one with `npm run backup:keygen -- --out <path>`). Keep it OFF the host that stores the backups; a backup directory that also holds the key is not an off-host design.
BACKUP_ENCRYPTION_KEY_FILE=C:/ForMe/Learning/Running_Tracker/.local/backup-keys/restore-drill.key
# Optional: run pg_dump/pg_restore inside this container (docker exec) instead of using client tools installed on this machine.
BACKUP_PG_DOCKER_CONTAINER=running-tracker-postgres-1
# Local restore drill only. A superuser on a LOOPBACK server, and the three application roles' passwords. The role URLs carry a template drill database name; the drill derives its own databases from it and never touches running_tracker, running_tracker_test or running_tracker_load_test.
RESTORE_DRILL_ADMIN_URL=postgresql://running_tracker:running_tracker_local@127.0.0.1:5433/postgres
RESTORE_DRILL_OWNER_URL=postgresql://running_tracker_owner:owner_local_only@127.0.0.1:5433/running_tracker_restore_drill
RESTORE_DRILL_RUNTIME_URL=postgresql://running_tracker_runtime:runtime_local_only@127.0.0.1:5433/running_tracker_restore_drill
RESTORE_DRILL_MAINTENANCE_URL=postgresql://running_tracker_maintenance:maintenance_local_only@127.0.0.1:5433/running_tracker_restore_drill
